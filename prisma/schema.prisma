// Certidrill — data model (spec §8).
// Variable, type-specific question content lives in JSONB validated by the Zod
// schemas in lib/questions/schema.ts. Every user-facing text is localized
// ({ en, fr }) inside its JSON column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum ContentStatus {
  draft
  needs_review
  reviewed
  published
  retired
}

enum QuestionType {
  single
  multi
  yesno_statements
  dropdown
  dragdrop
  ordering
  hotarea
  series_yesno
}

enum AttemptMode {
  exam
  practice
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum SectionKind {
  case_study
  series
  main
}

/// Offers (docs: specs des offres §2 and §4).
enum PlanKind {
  free
  pass
  subscription
  team
  pack
}

enum TaxBehavior {
  inclusive
  exclusive
}

enum BillingInterval {
  none
  month
  year
}

enum EntitlementSource {
  purchase
  pack_code
  extension
  admin
}

enum ReportStatus {
  open
  accepted
  rejected
}

// ---------------------------------------------------------------- users & auth

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  locale        String    @default("en")
  role          Role      @default(user)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  attempts     Attempt[]
  reports      QuestionReport[]
  outcomes     ExamOutcome[]
  entitlements Entitlement[]

  @@map("user")
}

// Auth.js adapter tables (OAuth accounts in V2, sessions, magic-link tokens).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("auth_account")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("auth_verification_token")
}

// ---------------------------------------------------------------- referential

model Certification {
  id         String  @id @default(cuid())
  code       String  @unique // e.g. "az-104"
  title      String
  vendor     String
  active     Boolean @default(true)
  /// Full access for every signed-in user (e.g. a free entry-level certification).
  freeAccess Boolean @default(false)

  blueprints     Blueprint[]
  caseStudies    CaseStudy[]
  questionSeries QuestionSeries[]
  questions      Question[]
  attempts       Attempt[]
  outcomes       ExamOutcome[]
  entitlements   Entitlement[]

  @@map("certification")
}

model Blueprint {
  id              String   @id @default(cuid())
  certificationId String
  version         String
  durationMin     Int
  minQuestions    Int
  maxQuestions    Int
  passScore       Int
  maxScore        Int      @default(1000)
  /// { [QuestionType]: { min: number, max: number } } — share of the exam (0..1)
  typeMix         Json
  /// { easy: number, medium: number, hard: number } — shares summing to 1
  difficultyMix   Json
  /// Sections layout & assembly rules (case studies, series, per-objective cap…)
  structure       Json
  current         Boolean  @default(false)
  createdAt       DateTime @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  domains       Domain[]
  attempts      Attempt[]

  @@unique([certificationId, version])
  @@map("blueprint")
}

model Domain {
  id          String @id @default(cuid())
  blueprintId String
  code        String // stable key inside the blueprint, e.g. "identities"
  order       Int
  /// { en, fr }
  title       Json
  weightMin   Float
  weightMax   Float

  blueprint  Blueprint   @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  objectives Objective[]

  @@unique([blueprintId, code])
  @@map("domain")
}

model Objective {
  id       String  @id @default(cuid())
  domainId String
  code     String // stable key, e.g. "1.1.1" — referenced by question YAML files
  order    Int
  /// { en, fr }
  group    Json
  /// { en, fr }
  title    Json
  learnUrl String?

  domain    Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([domainId, code])
  @@map("objective")
}

// ---------------------------------------------------------------- content

model CaseStudy {
  id              String        @id // stable id from content/ (e.g. "cs-contoso-01")
  certificationId String
  /// { en, fr }
  title           Json
  /// [{ key, title: { en, fr }, body: { en, fr } }] — Markdown
  tabs            Json
  status          ContentStatus @default(draft)
  version         Int           @default(1)

  certification Certification    @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions     Question[]
  sections      AttemptSection[]

  @@map("case_study")
}

model QuestionSeries {
  id              String        @id // stable id from content/
  certificationId String
  /// { en, fr } — Markdown shared stem
  stem            Json
  status          ContentStatus @default(draft)
  version         Int           @default(1)

  certification Certification    @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions     Question[]
  sections      AttemptSection[]

  @@map("question_series")
}

model Question {
  id               String        @id // stable id from content/ (same for en and fr)
  certificationId  String
  objectiveId      String
  type             QuestionType
  difficulty       Int // 1..3
  /// { en, fr } — Markdown
  stem             Json
  /// [{ id, kind: "image"|"table"|"code", ... localized }]
  exhibits         Json          @default("[]")
  /// type-specific: options, statements, lists, targets… (localized texts)
  body             Json
  /// type-specific correct answer — NEVER sent before submission
  answer           Json
  /// { correct: {en,fr}, options?: { [optionId]: {en,fr} } } — NEVER sent before submission
  explanation      Json
  /// [{ title, url }]
  references       Json          @default("[]")
  caseStudyId      String?
  seriesId         String?
  seriesOrder      Int?
  shuffle          Boolean       @default(true)
  status           ContentStatus @default(draft)
  version          Int           @default(1)
  blueprintVersion String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  certification Certification    @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  objective     Objective        @relation(fields: [objectiveId], references: [id])
  caseStudy     CaseStudy?       @relation(fields: [caseStudyId], references: [id])
  series        QuestionSeries?  @relation(fields: [seriesId], references: [id])
  items         AttemptItem[]
  reports       QuestionReport[]

  @@index([certificationId, status])
  @@index([objectiveId])
  @@map("question")
}

// ---------------------------------------------------------------- attempts

model Attempt {
  id              String        @id @default(cuid())
  userId          String
  certificationId String
  blueprintId     String
  mode            AttemptMode   @default(exam)
  locale          String
  seed            String
  startedAt       DateTime?
  deadlineAt      DateTime?
  submittedAt     DateTime?
  status          AttemptStatus @default(in_progress)
  scaledScore     Int?
  passed          Boolean?
  createdAt       DateTime      @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification    @relation(fields: [certificationId], references: [id])
  blueprint     Blueprint        @relation(fields: [blueprintId], references: [id])
  sections      AttemptSection[]
  items         AttemptItem[]

  // Partial unique index "attempt_one_in_progress" (one in_progress attempt per
  // user and certification) is created in SQL — see the init migration.
  @@index([userId, certificationId, status])
  @@map("attempt")
}

model AttemptSection {
  id          String      @id @default(cuid())
  attemptId   String
  order       Int
  kind        SectionKind
  caseStudyId String?
  seriesId    String?
  lockedAt    DateTime?

  attempt   Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  caseStudy CaseStudy?      @relation(fields: [caseStudyId], references: [id])
  series    QuestionSeries? @relation(fields: [seriesId], references: [id])
  items     AttemptItem[]

  @@unique([attemptId, order])
  @@map("attempt_section")
}

model AttemptItem {
  id           String    @id @default(cuid())
  attemptId    String
  sectionId    String
  questionId   String
  order        Int
  /// Frozen display order of options/statements/targets for this attempt
  optionOrder  Json      @default("{}")
  response     Json?
  flagged      Boolean   @default(false)
  answeredAt   DateTime?
  pointsEarned Float?
  pointsMax    Float?

  attempt  Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section  AttemptSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@unique([attemptId, order])
  @@map("attempt_item")
}

model QuestionReport {
  id         String       @id @default(cuid())
  questionId String
  userId     String
  reason     String
  comment    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, status])
  @@map("question_report")
}

// ---------------------------------------------------------------- real exam outcomes

/// Result of the real certification exam, as reported by the candidate. Used
/// to calibrate the readiness index against reality (admin page), never shown
/// to other users. One report per user, certification and day.
model ExamOutcome {
  id               String   @id @default(cuid())
  userId           String
  certificationId  String
  takenOn          DateTime @db.Date
  passed           Boolean
  /// Score announced by the vendor, if the candidate gives it.
  score            Int?
  /// What the readiness index said at the end of the day before the real exam
  /// (null without any mock exam by then), and how many mock exams it saw.
  readinessIndex   Int?
  readinessVerdict String?
  mockExams        Int      @default(0)
  createdAt        DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@unique([userId, certificationId, takenOn])
  @@index([certificationId])
  @@map("exam_outcome")
}

// ------------------------------------------------------------------ offers and access

/// Catalogue of offers and prices. Prices, durations and limits are data:
/// changing them needs no deployment (lib/access).
model Plan {
  id            String          @id @default(cuid())
  code          String          @unique
  kind          PlanKind
  amountCents   Int
  currency      String          @default("eur")
  taxBehavior   TaxBehavior     @default(inclusive)
  interval      BillingInterval @default(none)
  /// Length of the access a Pass gives, in days.
  durationDays  Int?
  minSeats      Int?
  /// Full mock exams per certification at this level (the free plan); null: unlimited.
  examQuota     Int?
  stripePriceId String?         @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@map("plan")
}

/// A Pass-type right: full access to one certification between two dates.
model Entitlement {
  id              String            @id @default(cuid())
  userId          String
  certificationId String
  source          EntitlementSource
  startsAt        DateTime
  expiresAt       DateTime
  /// The payment that created it (payment table: offers lot B).
  paymentId       String?
  /// Set when the right is withdrawn (refund): it no longer gives access.
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@index([userId, certificationId])
  @@map("entitlement")
}

/// Switches and settings changed without deployment (offer.*.enabled, signup.open).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}
