# Cloudflare proxies every request: without this, Caddy would see a
# Cloudflare address as the client, and the per-IP limits of the app (sign-in,
# sign-up) would count every visitor of a Cloudflare node together. From these
# ranges only (https://www.cloudflare.com/ips), the client address is read from
# CF-Connecting-IP, which Cloudflare sets itself. Update the list if it changes.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Same limit as the app (lib/api.ts, MAX_BODY_BYTES): refused here before reaching Node.
	request_body /api/* {
		max_size 64KiB
	}
	# X-Real-IP: the client address as resolved above, replacing any value
	# sent by the client (lib/security/rate-limit.ts, clientIp).
	reverse_proxy app:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# www.<domain> → <domain>, path and query kept. Needs a DNS record for www
# (CNAME www → <domain>, proxied like the apex) so Caddy can get its certificate.
www.{$SITE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$SITE_DOMAIN}{uri} permanent
}
