# Only if Cloudflare proxies the site (today the DNS, at Ionos, points straight
# at the server, and these lines have no effect): without them, Caddy would see
# a Cloudflare address as the client, and the per-IP limits of the app (sign-in,
# sign-up) would count every visitor of a Cloudflare node together. From these
# ranges only (https://www.cloudflare.com/ips), the client address is read from
# CF-Connecting-IP, which Cloudflare sets itself; any other client keeps its own
# address, whatever it sends. Update the list if it changes.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Same limit as the app (lib/api.ts, MAX_BODY_BYTES): refused here before reaching Node.
	@api {
		path /api/*
		not path /api/webhooks/stripe
	}
	request_body @api {
		max_size 64KiB
	}
	# Stripe events are larger (app/api/webhooks/stripe/route.ts reads up to 256 KiB).
	request_body /api/webhooks/stripe {
		max_size 256KiB
	}
	# X-Real-IP: the client address as resolved above, replacing any value
	# sent by the client (lib/security/rate-limit.ts, clientIp).
	reverse_proxy app:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# www.<domain> and the other domains of the site (SITE_ALIASES, e.g.
# "certidrill.fr www.certidrill.fr", may be empty) → <domain>, path and query
# kept, so that search engines index a single address. Each name needs a DNS
# record pointing at this server (A, or CNAME www → <domain>) so Caddy can get
# its certificate. The variable is substituted before parsing: several names
# separated by spaces are several addresses of this block.
# SITE_ALIASES must not name SITE_DOMAIN or www.<domain> (Caddy refuses a site
# defined twice). HSTS here without includeSubDomains, so that the subdomains of
# an alias are not bound to HTTPS (www.<domain> is covered by the apex header).
www.{$SITE_DOMAIN} {$SITE_ALIASES} {
	header Strict-Transport-Security "max-age=31536000"
	redir https://{$SITE_DOMAIN}{uri} permanent
}
