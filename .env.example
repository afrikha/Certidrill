# PostgreSQL
DATABASE_URL="postgresql://certidrill:certidrill@localhost:5432/certidrill"
# Host port of the local database (docker-compose.dev.yml, npm run db:up). Port
# 5432 already taken by another PostgreSQL? Set 5433 here and in DATABASE_URL.
DB_PORT="5432"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Magic link e-mails (SMTP URL, e.g. smtp://user:pass@smtp.example.com:587 with
# STARTTLS, or smtps://…:465 — port 465 always needs smtps://). The connection must be encrypted: a server without
# STARTTLS is refused. Encode special characters of the password (%40 for @, %24 for $:
# docker compose would read $ as a variable).
# No query parameters (?pool=…): they are refused.
EMAIL_SERVER=""
EMAIL_FROM="Certidrill <no-reply@certidrill.com>"
# Check the settings with: npm run email:test -- --to you@example.com (README, "E-mails").
# Without SMTP, set to "true" to print magic links in the server log instead.
AUTH_LOG_MAGIC_LINKS="false"

# Let draft/reviewed questions into exams (local trials only; production uses published questions).
EXAM_INCLUDE_UNPUBLISHED="false"

# docker compose only
POSTGRES_PASSWORD="change-me"
SITE_DOMAIN="certidrill.com"
