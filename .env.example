# PostgreSQL
DATABASE_URL="postgresql://certidrill:certidrill@localhost:5432/certidrill"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Magic link e-mails (SMTP URL, e.g. smtp://user:pass@smtp.example.com:587).
EMAIL_SERVER=""
EMAIL_FROM="Certidrill <no-reply@certidrill.com>"
# Without SMTP, set to "true" to print magic links in the server log instead.
AUTH_LOG_MAGIC_LINKS="false"

# docker compose only
POSTGRES_PASSWORD="change-me"
SITE_DOMAIN="certidrill.com"
